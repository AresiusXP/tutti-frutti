<?xml version="1.0" encoding="utf-8"?>
<!-- Android 6-11 Auto Backup rules. The shell stores nothing (the browser keeps the site's data),
     and android:allowBackup is false; this excludes everything anyway. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
